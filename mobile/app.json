{
  "expo": {
    "name": "Decimal",
    "slug": "decimal-mobile",
    "version": "0.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "decimal",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.omixdigital.decimal"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.omixdigital.decimal"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "48a3bded-2eda-40f3-83c2-847a8f33eae7",
        "owner": "marvelxs-team"
      }
    }
  }
}
